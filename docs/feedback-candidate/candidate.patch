+/* Feedback remains independent of collection rendering and personal state. */
+#feedback-dialog { width: min(620px, calc(100% - 24px)); padding: 24px; }
+.feedback-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
